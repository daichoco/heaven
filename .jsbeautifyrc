{
  "html": {
    "indent_size": 2,
    "indent_inner_html": true,
    "wrap_line_length": 0,
    "wrap_attributes": "preserve",
    "preserve_newlines": false,
    "extra_liners": [],
    "content_unformatted": ["pre", "textarea", "script", "style", "p"],
    "end_with_newline": true,
    "eol": "\n",
    "templating": ["none"]
  }
}
